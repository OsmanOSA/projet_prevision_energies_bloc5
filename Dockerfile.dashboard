# Dockerfile pour Dashboard Dash
FROM python:3.10-slim

# Variables d'environnement
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

# Répertoire de travail
WORKDIR /app

# Installer les dépendances système si nécessaires
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copier le fichier requirements pour le dashboard
COPY requirements.txt .

# Installer les dépendances Python
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copier les fichiers nécessaires pour le dashboard
COPY frontend/ ./frontend/
COPY pipeline_prevision/ ./pipeline_prevision/
COPY data_schema/ ./data_schema/

# Créer un utilisateur non-root pour la sécurité
RUN useradd --create-home --shell /bin/bash app && \
    chown -R app:app /app
USER app

# Port d'exposition
EXPOSE 8050

# Variables d'environnement par défaut
ENV DEBUG=False
ENV PORT=8050

# Commande de démarrage
CMD ["python", "frontend/dash_app.py"]
