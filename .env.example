# Exemple de configuration. Copier les variables utiles dans votre .env réel.
# Le .env réel (avec les secrets RTE/Meteostat) n'est pas versionné.

# --- PostgreSQL (persistance) ---
# Valeurs par défaut alignées sur docker-compose.yml : rien à changer en local.
POSTGRES_USER=energia
POSTGRES_PASSWORD=energia
POSTGRES_DB=energia
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Alternative : URL complète (prioritaire si définie)
# DATABASE_URL=postgresql+psycopg2://energia:energia@localhost:5432/energia

# --- Airflow ---
# Clé partagée entre webserver/scheduler (signe les JWT de lecture des logs de
# tâches). Générer la vôtre : openssl rand -hex 32
AIRFLOW_SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
# Identifiants admin Airflow (remplacent le défaut admin/admin) : obligatoire
# dès que le service est exposé au-delà de votre poste.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme_strong_password

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_strong_password

# --- Reverse-proxy public (Caddy) ---
# Vide -> HTTP simple sur l'IP. Domaine réel pointant vers la machine ->
# HTTPS automatique (Let's Encrypt), sans configuration supplémentaire.
# DOMAIN=energia.example.com

# --- MLflow (suivi d'expériences) ---
# Depuis l'hôte : localhost. Depuis un conteneur : http://mlflow:5000
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=energia_forecasting
MLFLOW_MODEL_NAME=energia_forecasting_model

# --- Sources de données (déjà présentes dans votre .env) ---
# LAT=48.8566
# LON=2.3522
# URL_TOKEN=...
# CLIENT_ID_2=...
# CLIENT_SECRET_2=...
# BASE_URL_PROD=...
# BASE_URL_CONSO_FORECAST=...  # API RTE Consumption, type=D-1 (prévision J-1, référence de crédibilité)
