# Exemple de configuration. Copier les variables utiles dans votre .env réel.
# Le .env réel (avec les secrets RTE/Meteostat) n'est pas versionné.

# --- PostgreSQL (persistance) ---
# Valeurs par défaut alignées sur docker-compose.yml : rien à changer en local.
POSTGRES_USER=energia
POSTGRES_PASSWORD=energia
POSTGRES_DB=energia
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Alternative : URL complète (prioritaire si définie)
# DATABASE_URL=postgresql+psycopg2://energia:energia@localhost:5432/energia

# --- Airflow ---
# Clé partagée entre webserver/scheduler (signe les JWT de lecture des logs de
# tâches). Générer la vôtre : openssl rand -hex 32
AIRFLOW_SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
# Identifiants admin Airflow (remplacent le défaut admin/admin) : obligatoire
# dès que le service est exposé au-delà de votre poste.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme_strong_password

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_strong_password

# --- Reverse-proxy public (Caddy) ---
# Vide -> HTTP simple sur l'IP. Domaine réel pointant vers la machine ->
# HTTPS automatique (Let's Encrypt), sans configuration supplémentaire.
# DOMAIN=energia.example.com

# --- MLflow (suivi d'expériences) ---
# Depuis l'hôte : localhost. Depuis un conteneur : http://mlflow:5000
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=energia_forecasting
MLFLOW_MODEL_NAME=energia_forecasting_model

# --- Sources de données ---
# Meteostat (température) : coordonnées du point interrogé.
# LAT=48.8566
# LON=2.3522

# RTE expose deux produits API distincts, chacun avec ses propres identifiants
# OAuth (portail RTE Data Hub) : inscrire l'appli à chaque produit séparément.
#
# 1) API "Consumption" (CLIENT_ID/CLIENT_SECRET) : sert deux endpoints avec
#    les mêmes identifiants -- réalisé (extract_conso, BASE_URL_CONSO) et
#    prévision officielle J-1 (extract_conso_forecast_rte,
#    BASE_URL_CONSO_FORECAST, repère de crédibilité affiché sur le dashboard,
#    jamais utilisé pour entraîner le modèle).
# URL_TOKEN=https://digital.iservices.rte-france.com/token/oauth/
# CLIENT_ID=...
# CLIENT_SECRET=...
# BASE_URL_CONSO=https://digital.iservices.rte-france.com/open_api/consumption/v1/short_term?type=REALISED
# BASE_URL_CONSO_FORECAST=...

# 2) API "Actual Generation" (CLIENT_ID_2/CLIENT_SECRET_2, extract_production,
#    BASE_URL_PROD) : identifiants distincts, produit API différent.
# CLIENT_ID_2=...
# CLIENT_SECRET_2=...
# BASE_URL_PROD=https://digital.iservices.rte-france.com/open_api/actual_generation/v1/actual_generations_per_production_type?

# --- Chemins / divers (valeurs par défaut sensées, à ne changer que si besoin) ---
# MODEL_DIR=final_models          # défaut : final_models/ à la racine du projet
# MODEL_OUTPUT_DIR=candidate_models  # défaut utilisé par retrain.py/main.py
# DISPLAY_TZ=Europe/Paris         # fuseau d'affichage du dashboard Streamlit
